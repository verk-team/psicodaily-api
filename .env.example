SECRET_KEY=sua-chave-secreta

# Dev: caminho absoluto do .FDB local. Na VPS o docker-compose.yml define o caminho do volume
DB_DATABASE=caminho-do-banco
DB_HOST=localhost
DB_USER=usuario-do-banco
DB_PASSWORD=senha-do-banco
DB_CHARSET=UTF8
# So no primeiro boot de um ambiente novo: o entrypoint cria o banco vazio se ele nao existir
# CRIAR_BANCO=1

CLIENT_ID=seu-client-id-arkhe
CLIENT_SECRET=seu-secret-arkhe

# Cloudflare R2 (fotos de perfil no bucket publico, arquivos do chat no privado; o token precisa dos dois)
ENDPOINT_URL=https://<account-id>.r2.cloudflarestorage.com
ACCESS_KEY_ID=sua-access-key-r2
SECRET_ACCESS_KEY=sua-secret-key-r2
R2_PUBLIC_URL=https://pub-b6945a8ffa914112b679b4f615712e92.r2.dev
R2_BUCKET_PRIVADO=psicodaily-objects

# Gmail que envia os e-mails (codigos, avisos). A senha e uma "senha de app" de 16 letras, nao a senha da conta:
# myaccount.google.com/apppasswords (exige verificacao em duas etapas). Sem as duas, nenhum e-mail e enviado.
SMTP_USER=psicodaily.contato@gmail.com
SMTP_PASSWORD=senha-de-app-do-gmail

# Front usado nos links dos e-mails (ex.: aviso de entrada na sala)
FRONT_URL=https://psicodaily-front.vercel.app

# TURN da videochamada (GET /api/consultas/<id>/ice-servers): Cloudflare > Realtime > TURN > Create TURN key.
# Sem elas a chamada usa so STUN e falha em parte das redes moveis. Chave invalida tambem cai no STUN (com erro no log).
TURN_KEY_ID=seu-turn-key-id
TURN_KEY_API_TOKEN=seu-turn-key-api-token

# Assistente de IA (POST /api/assistente): chave gratuita em aistudio.google.com/apikey
GEMINI_API_KEY=sua-chave-gemini

# WhatsApp pelo WAHA (servico proprio, pausado). Sem WAHA_URL, nada e enviado.
WAHA_URL=http://waha:3000
WAHA_API_KEY=mesma-chave-do-WAHA_API_KEY-do-servico-waha
# Mesma chave do WHATSAPP_HOOK_HMAC_KEY do WAHA: o webhook so aceita eventos assinados
WAHA_HMAC_KEY=chave-hmac-do-webhook
# JOBS=0 desliga a thread de lembretes (os testes fazem isso)
# JOBS=1
